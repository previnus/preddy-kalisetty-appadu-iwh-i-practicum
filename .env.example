# Enter the token locally. Never paste it in chat or commit .env.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_TEST_ACCOUNT_ID=
# Set true only after checking that this is a developer test account.
HUBSPOT_IS_TEST_ACCOUNT=false
# Filled after npm run setup:hubspot succeeds (for example 2-1234567).
HUBSPOT_CUSTOM_OBJECT_ID=
PORT=3000
